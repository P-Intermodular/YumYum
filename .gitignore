# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local environment
.env
.env.*
!.env.example

# Prototipos de referencia (Figma + funciones). Se mantienen en local
# como guía visual y de estructura, no forman parte del código entregable.
prototipo-figma/
prototipo-funciones/
.render/

# Configuración local de Codex CLI (MCP, etc.)
.codex/

# Large documentation exports stay local; only the canonical .md is versioned.
/documentacion/*
!/documentacion/
!/documentacion/documentacion_tecnica.md
!/documentacion/00_LEEME_PRIMERO.md
!/documentacion/01_vision_y_stack.md
!/documentacion/02_arquitectura_y_carpetas.md
!/documentacion/03_base_de_datos.md
!/documentacion/04_api_y_backend.md
!/documentacion/05_flujos_de_negocio.md
!/documentacion/06_reglas_de_negocio.md
!/documentacion/07_estado_y_deuda_tecnica.md

# Residuos de symlinks de WSL (creados por scripts/run_local.sh).
/build.reparsepoint.bak
/scripts/build
